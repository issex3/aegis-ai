ENVIRONMENT=development
DATABASE_URL=sqlite:///./aegis.db
ENCRYPTION_KEY=replace-with-a-fernet-key
ENCRYPTION_KEY_PREVIOUS=
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
SESSION_TTL_HOURS=12
SESSION_IDLE_HOURS=8
AUTH_RATE_LIMIT_ENABLED=true
# Production must set ENVIRONMENT=production, COOKIE_SECURE=true, MFA_REQUIRED_FOR_ADMINS=true,
# an https PUBLIC_APP_URL, PostgreSQL, and a real ENCRYPTION_KEY. The process refuses to start otherwise.
MFA_REQUIRED_FOR_ADMINS=false
TRUSTED_PROXY_IPS=127.0.0.1,::1
MAX_REQUEST_BYTES=1048576
LOG_LEVEL=INFO
POSTGRES_PASSWORD=aegis-dev-only
REDIS_PASSWORD=aegis-dev-only

# Used by the Next.js server to reach FastAPI. The browser calls the Next.js origin.
API_INTERNAL_URL=http://127.0.0.1:8000

# Production should use PostgreSQL. SQLite is for local development only.
# DATABASE_URL=postgresql+psycopg://aegis:change-me@postgres:5432/aegis

# When true, agent creation and assessment runs require an active subscription.
BILLING_ENFORCE=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_BUSINESS=
PUBLIC_APP_URL=http://localhost:3000

# Leave empty to run assessment jobs in-process after they are written to the database.
# Set this in production so a Celery worker consumes the same job rows.
CELERY_BROKER_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=reports@aegis.example
